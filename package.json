{
  "name": "@canopyhub/canopy-sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for Canopy Protocol",
  "keywords": [
    "movement",
    "defi",
    "vault",
    "canopy",
    "typescript",
    "sdk"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "core": [
        "dist/core.d.ts"
      ],
      "deployments": [
        "dist/deployments.d.ts"
      ],
      "bindings": [
        "dist/bindings.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.js"
    },
    "./deployments": {
      "types": "./dist/deployments.d.ts",
      "import": "./dist/deployments.mjs",
      "require": "./dist/deployments.js"
    },
    "./bindings": {
      "types": "./dist/bindings.d.ts",
      "import": "./dist/bindings.mjs",
      "require": "./dist/bindings.js"
    }
  },
  "files": [
    "dist",
    "packages/deployments/addresses",
    "README.md"
  ],
  "homepage": "https://github.com/Canopyxyz/canopy-sdk#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "pnpm --filter @canopyhub/canopy-sdk-core run build && pnpm --filter @canopyhub/canopy-sdk-deployments run build && pnpm --filter @canopyhub/canopy-sdk-bindings run build && tsup",
    "dev": "tsup --watch",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "lint": "eslint \"packages/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "abi:fetch": "node scripts/abi/fetch-abis.mjs",
    "abi:check": "node scripts/abi/fetch-abis.mjs --check",
    "abi:check-local": "node scripts/abi/check-local-abis.mjs",
    "check:exports": "node scripts/ci/check-exports.mjs",
    "check:imports": "node scripts/ci/check-imports.mjs",
    "check:no-surf-public-api": "node scripts/ci/check-no-surf-public-api.mjs",
    "validate:deployments": "node -e \"import('./dist/deployments.mjs').then(({listDeployments})=>{listDeployments(); console.log('deployments ok')})\"",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@aptos-labs/ts-sdk": "^7.0.1",
    "@thalalabs/surf": "^2.0.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.4.0",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^9.35.0",
    "jest": "^30.1.3",
    "ts-jest": "^29.4.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "bugs": {
    "url": "https://github.com/Canopyxyz/canopy-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Canopyxyz/canopy-sdk.git",
    "directory": "canopy-sdk"
  },
  "author": "Canopy Protocol",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9"
}
