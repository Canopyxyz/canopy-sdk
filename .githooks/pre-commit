#!/usr/bin/env bash
set -euo pipefail

staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"

if [[ -z "$staged_files" ]]; then
  exit 0
fi

if grep -Eq '^(packages/deployments/addresses/|packages/bindings/abis/|packages/bindings/src/chains/|scripts/abi/abi-manifest\.mjs)' <<<"$staged_files"; then
  echo "Running local ABI consistency checks..."
  pnpm run abi:check-local
fi
